#!/usr/bin/env python3
"""fork/bin/sync: every step of the upstream sync run that reads or writes state, git refs or GitHub, so the agent
decides and the code checks (fork/specs/sync-pipeline.md). Each subcommand prints one JSON line and exits 0 only
when its step passed.

  preflight --run <key> --folder <space>   checks the repo, takes the run's lease, reads state, says where to resume
                                           and what (resuming: the path, release, candidate and sync branch);
                                           --pending "<title>": Install merged's merge, kept for the lease's owner
  select --run <key> --folder <space>      the newest stable release, and the run's path: nothing, install-main, take
  settle --run <key> --folder <space>      Install merged: main's tip pinned, and the path: nothing, skip, install-merged
  review-inputs --run <key> --folder <space>   the reviewer's three diffs for the pushed sync branch, as files
  merge <pr> --run <key> --folder <space>  the one merge route for a sync PR: its gates, the merge, main's checks
  baseline --run <key> --folder <space> [--capture]   what is installed, proven to match the install folder
  install <sha> --run <key> --folder <space>   the checks, the install folder moved, the update asked for and read
  health <sha> --run <key> --folder <space>    the health check; a pass makes the candidate the baseline
  rollback --run <key> --folder <space>    back to the baseline, verified by health on it
  public-check <file>                      refuses text with paths, hosts, emails or raw output before GitHub
  finish --run <key> --folder <space> [--says "<what's new>"]   the exact completion command for the outcome
                                           (outcome again: merges are pending, settle again; next: ci)
  ci --run <key> --folder <space>          CI's verdict on this run's installs of our merges, the lease let go, then
                                           the completion command
  issues <sha> --run <key> --folder <space> [--dry-run]   after a healthy install: our issues' status lines and
                                           labels from the patch list there, one pass, writing only what changes
  part-of --base <sha> --head <sha> --body-file <f>   the fork check: a pull request that changes a patch file
                                           names its issue (Part of #n); refused with the lines to add
  hold --run <key> --folder <space> ...    writes the held record (or records the 24-hour question, or its answer)
  held                                     reads the held records, and whether each one's question is due
  patch-list [--at <sha>]                  the patches this tree (or that commit) carries: fork/patches/<issue>.json
  patch-tests [--issue <n>]                runs each patch's tests in this tree (only those named)
  clear-broken                             the person's only: clears a broken phase (refused in a task's terminal)

The git steps work in the current folder, the run's worktree (--repo names another). Every subcommand takes
--root <dir> (the home unless named: the rehearsal and tests use a scratch one). A new step is one more entry in
COMMANDS."""
import argparse
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))  # fork/

from sync import gate, install, issues, labels, merged, patches, public, release, state  # noqa: E402
from sync.state import Refused  # noqa: E402


def git(folder, *args):
    r = subprocess.run(["git", "-C", folder, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


ORIGIN = release.GITHUB


def check_repo(folder):
    """`gh repo set-default --view` prints the fork, `origin` is the fork, and the space folder is on main (tasks
    take its current branch as their base)."""
    if not os.path.isdir(folder):
        raise Refused("the space folder isn't there", outcome="stop")
    try:
        r = subprocess.run(["gh", "repo", "set-default", "--view"], cwd=folder, capture_output=True, text=True,
                           timeout=60)
        default = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        default = ""
    if default != state.REPO:
        raise Refused(f"gh's default repo here isn't {state.REPO}; nothing was written", outcome="held", kind="pipeline")
    m = ORIGIN.match(git(folder, "remote", "get-url", "origin") or "")
    if not m or m.group(1) != state.REPO:
        raise Refused(f"origin isn't {state.REPO}; nothing was written", outcome="held", kind="pipeline")
    branch = git(folder, "branch", "--show-current")
    if branch != "main":
        raise Refused(f"the space folder is on {branch or 'a detached HEAD'}, not main; nothing was written",
                      outcome="held", kind="pipeline")


# --- the subcommands: each takes (args, paths) and returns its JSON fields, or raises Refused ---

def preflight(a, p):
    check_repo(a.folder)
    state.check_machine(state.config(p))
    refused = None
    with state.locked(p) as st:
        try:
            if st.get("phase") == "broken":
                raise Refused("the last rollback failed (phase broken): only the person clears it "
                              "(fork/bin/sync clear-broken)", outcome="broken")
            took = state.take_lease(st, a.run, a.folder)
        except Refused as e:
            if a.pending is None:
                raise
            # Installing our own merges: the merge waits in `pending` for the lease's owner (or the person's clear),
            # written in this same lock (raising inside it would discard the write)
            merged.record_pending(st, a.pending, cfg_hostname=hostname(p))
            e.fields["pending"] = True
            refused, took = e, None
        if not refused:
            if a.pending is not None:
                # a takeover resumes the old owner's candidate: this merge waits in pending all the same (a settle
                # that pins main after it clears it)
                merged.record_pending(st, a.pending, cfg_hostname=hostname(p))
            if took:
                ok, head, _ = release.git(os.path.abspath(a.repo), "rev-parse", "--verify", "HEAD^{commit}")
                adopted = state.adopt_run(st, a.run, a.folder, start=head if ok else None)
                if adopted:
                    took["selection"] = adopted     # the selection this run resumes was that run's
            out = {"run": a.run, "phase": st.get("phase"), "resume": state.resume_point(st), "took_over": took,
                   "held": len(st.get("held") or []), "resuming": resuming(st),
                   "issue_cursor": st.get("issue_cursor"), "pending": bool(st.get("pending"))}
    if refused:
        raise refused
    return out


def resuming(st):
    """What an unfinished phase is about, so the run that picks it up can name it in its next call: the path, the
    release, the candidate and the sync branch (its head, its pull request once merge recorded it, its merge
    commit). None when there is nothing to resume."""
    if not state.resume_point(st):
        return None
    sync = st.get("sync") or {}
    return {"path": (st.get("run") or {}).get("path"), "release": st.get("release"), "candidate": st.get("candidate"),
            "sync": {k: sync.get(k) for k in ("branch", "head", "pr", "merge_commit")} if sync else None}


def preflight_args(c):
    c.add_argument("--run", required=True, help="the run's task key")
    c.add_argument("--folder", required=True, help="the space folder")


def preflight_only_args(c):
    run_args(c)
    c.add_argument("--pending", metavar="TITLE", help="Install merged: the merged task's title, kept in pending when "
                                                       "another run owns the lease (its owner installs it)")


def hold(a, p):
    with state.locked(p) as st:
        state.owns_lease(st, a.run, a.folder)
        if a.asked:
            rec = state.ask(st, a.blocker, a.run, a.folder)
            return {"held": rec}
        if a.answer is not None:
            rec = state.answer(st, a.blocker, a.answer)
            return {"held": rec}
        if not (a.tag and a.sha and a.kind):
            raise Refused("hold names --tag, --sha and --kind (or --asked, or --answer)", outcome="stop")
        state.set_phase(st, "held")
        rec, new = state.hold(st, a.tag, a.sha, a.kind, a.blocker, a.line, branch=a.branch, pr=a.pr,
                              head=a.head, files=a.files, issue=a.issue)
        # finish reads which record held this run, and whether the person hears of it now (only the first time)
        r = st.get("run") if (st.get("run") or {}).get("key") == a.run else {"key": a.run, "folder": a.folder}
        was = r.get("held") or {}
        told = new or (was.get("blocker") == a.blocker and bool(was.get("new")))
        st["run"] = dict(r, held={"blocker": a.blocker, "new": told})
        return {"held": rec, "new": new}


def hold_args(c):
    c.add_argument("--run", required=True, help="the run's task key (it must own the lease)")
    c.add_argument("--folder", required=True, help="the space folder")
    c.add_argument("--blocker", required=True, help="the patch's issue number, else the gate's name")
    c.add_argument("--tag", help="the release held, vX.Y.Z")
    c.add_argument("--sha", help="the release's full SHA")
    c.add_argument("--kind", choices=state.HELD_KINDS)
    c.add_argument("--line", default="", help="one sanitized line on what holds it")
    c.add_argument("--branch", help="a draft's branch")
    c.add_argument("--pr", type=int, help="a draft's pull request")
    c.add_argument("--head", help="a draft's head SHA")
    c.add_argument("--files", nargs="+", help="a conflict's conflicted paths")
    c.add_argument("--issue", type=int, help="the sync-blocked issue")
    one = c.add_mutually_exclusive_group()
    one.add_argument("--asked", action="store_true", help="records that this run asks the 24-hour question now")
    one.add_argument("--answer", help="records the person's answer to it")


def held(a, p):
    with state.locked(p) as st:
        recs = [dict(h) for h in st.get("held") or []]
    for h in recs:
        h["due"] = state.question_due(h)
    return {"held": recs}


def clear_broken(a, p):
    with state.locked(p) as st:
        state.clear_broken(st)
    return {"phase": None}


def read_patches(repo, at=None):
    """The patch list's lines and layout problems (fork/sync/patches.py's one loader), or refused."""
    try:
        return patches.read(repo, at)
    except (OSError, ValueError, KeyError, TypeError) as e:
        raise Refused(f"the patch list ({patches.DIR}/) can't be read ({type(e).__name__})", outcome="stop")


def patch_list(a, p):
    """The patches a tree or a commit carries.
    Refused when the list is laid out wrong (the old list kept beside the new folder could hide a lost patch)."""
    lines, layout = read_patches(os.path.abspath(a.repo), a.at)
    if layout:
        raise Refused("the patch list is laid out wrong: " + "; ".join(layout), outcome="stop", problems=layout)
    return {"patches": [{"issue": x.get("issue"), "name": x.get("name")} for x in lines]}


def patch_list_args(c):
    c.add_argument("--repo", default=".", help="the repo (default: here)")
    c.add_argument("--at", help="a commit to read the list at, instead of the working tree")


def patch_tests(a, p):
    """Each line's tests, in the tree at --repo (the sync's merge, its step 4): first the list itself is checked."""
    repo = os.path.abspath(a.repo)
    lines, found = read_patches(repo)
    found = found + patches.problems(repo, lines)
    if found:
        raise Refused("the patch list doesn't match this tree: " + "; ".join(found), outcome="stop", problems=found)
    if a.issue is not None:
        lines = [x for x in lines if x["issue"] == a.issue]
        if not lines:
            raise Refused(f"the patch list has no line for #{a.issue}", outcome="stop")
    done = [{"issue": x["issue"], "name": x["name"], "tests": patches.run(repo, x)} for x in lines]
    failed = [d["issue"] for d in done if not all(t["ok"] for t in d["tests"])]
    if failed:
        raise Refused("a patch's tests fail: " + ", ".join(f"#{n}" for n in failed), outcome="stop", failed=failed,
                      patches=done)
    return {"patches": done}


def patch_tests_args(c):
    c.add_argument("--repo", default=".", help="the tree whose patch list (fork/patches/) runs (default: here)")
    c.add_argument("--issue", type=int, help="only that patch's line")


def run_args(c):
    preflight_args(c)
    c.add_argument("--repo", default=".", help="the run's worktree (default: here)")


def select(a, p):
    repo = os.path.abspath(a.repo)
    with state.locked(p) as st:
        state.owns_lease(st, a.run, a.folder)
        if st.get("phase") in state.MOVING:
            raise Refused(f"the phase is {st['phase']}: finish that first (preflight says where to resume)",
                          outcome="stop")
        baseline = (st.get("baseline") or {}).get("sha")
        bad = {q.get("sha") for q in st.get("quarantine") or []}
    got = release.select(repo, baseline, quarantined=lambda sha: sha in bad)
    merged.ci_glance(p, repo)  # #230: the last installs' CI, read once (no run waits for it)
    start = release.rev(repo, "HEAD")
    with state.locked(p) as st:
        state.owns_lease(st, a.run, a.folder)
        st["run"] = {"key": a.run, "folder": a.folder, "path": got["path"], "start": start, "at": state.stamp()}
        st["main"], st["in_main"] = got["main"], got["in_main"]
        if got["path"] != "nothing":
            state.set_phase(st, "selected")
            st["release"], st["candidate"], st["sync"] = dict(got["release"]), got["candidate"], None
        held_now = [h.get("blocker") for h in st.get("held") or []
                    if (h.get("release") or {}).get("tag") == got["release"]["tag"]
                    and not str(h.get("blocker") or "").startswith(state.MAIN_BLOCKER)]
        cursor = st.get("issue_cursor")      # the person's upstream issues are searched from here (finish moves it)
    return {**got, "held": held_now, "issue_cursor": cursor}


def review_inputs(a, p):
    return gate.review_inputs(p, a.run, a.folder, os.path.abspath(a.repo))


def merge(a, p):
    out = gate.merge(p, a.run, a.folder, os.path.abspath(a.repo), a.pr)
    if out.get("wait"):
        raise Refused(out["wait"], outcome="wait", **{k: v for k, v in out.items() if k != "wait"})
    return out


def merge_args(c):
    c.add_argument("pr", type=int, help="the sync PR's number")
    run_args(c)


def hostname(p):
    """The config's hostname, for the public check, when there is a config here."""
    try:
        return state.config(p)["hostname"]
    except Refused:
        return None


def public_check(a, p):
    try:
        if a.file == "-":
            text = sys.stdin.read()
        else:
            with open(a.file, encoding="utf-8") as f:
                text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise Refused(f"the text can't be read ({type(e).__name__})", outcome="stop")
    found = public.problems(text, hostname(p))
    if found:
        raise Refused(f"not for GitHub: {public.words(found)}", outcome="refused", problems=found)
    return {"lines": len(text.splitlines())}


def public_check_args(c):
    c.add_argument("file", help="the text bound for GitHub (- reads it from stdin)")


def live(a):
    """The real home: no --root (the rehearsal and tests name a scratch one)."""
    return a.root is None


def baseline(a, p):
    return install.baseline(p, a.run, a.folder, capture=a.capture, live=live(a))


def baseline_args(c):
    preflight_args(c)
    c.add_argument("--capture", action="store_true", help="the first run: record what is installed as the baseline")


def install_step(a, p):
    return install.install(p, a.run, a.folder, os.path.abspath(a.repo), a.sha, live=live(a))


def health(a, p):
    return install.health(p, a.run, a.folder, os.path.abspath(a.repo), a.sha, live=live(a))


def sha_args(c):
    c.add_argument("sha", help="the candidate's full SHA")
    run_args(c)


def rollback(a, p):
    return install.rollback(p, a.run, a.folder, live=live(a))


def finish(a, p):
    return gate.finish(p, a.run, a.folder, os.path.abspath(a.repo), says=a.says, cfg_hostname=hostname(p),
                       wait_ci=a.wait_ci)


def settle(a, p):
    out = merged.settle(p, a.run, a.folder, os.path.abspath(a.repo))
    merged.ci_glance(p, os.path.abspath(a.repo))  # #230: the last installs' CI, read once (no run waits for it)
    return out


def ci(a, p):
    return merged.ci_step(p, a.run, a.folder, os.path.abspath(a.repo), cfg_hostname=hostname(p))


def issues_step(a, p):
    """After a healthy install: a live comment on each issue whose fix this install brought, device checks, and the
    close of an issue whose linked Triage fix is live, in one pass that writes only what changes (fork/sync/issues.py).
    It never rewrites an issue's body. --dry-run writes nothing and shows the comments."""
    repo = os.path.abspath(a.repo)
    if not state.SHA.match(a.sha or ""):
        raise Refused("issues takes the installed commit's full SHA", outcome="stop")
    with state.locked(p) as st:
        if not a.dry_run:
            state.owns_lease(st, a.run, a.folder)
            if st.get("phase") != "healthy":
                raise Refused(f"the phase is {st.get('phase') or 'none'}: issues runs after a healthy install",
                              outcome="stop")
        base = st.get("baseline") or {}
        installs = [i for i in st.get("installs") or [] if state.SHA.match(i.get("sha") or "")]
    tag = a.tag if a.dry_run and a.tag else (base.get("tag") if base.get("sha") == a.sha else None)
    if not tag:
        raise Refused(f"{a.sha[:12]} isn't the installed baseline with a tag" +
                      (" (a dry run names one with --tag)" if a.dry_run else ""), outcome="stop")
    since = a.since
    if since is None:
        before = [i["sha"] for i in installs if i["sha"] != a.sha]
        since = before[-1] if before else None
    if since and not release.is_ancestor(repo, since, a.sha):
        since = None                    # a rollback's or another line's commit: every pull request counts as new
    try:
        return issues.run(repo, a.sha, since, tag, issues.release_in(repo, a.sha), gate.gh, dry_run=a.dry_run,
                          cfg_hostname=hostname(p))
    except (OSError, ValueError, KeyError, TypeError) as e:
        raise Refused(f"the patch list at {a.sha[:12]} can't be read ({type(e).__name__})", outcome="stop")


def labels_step(a, p):
    """Our repo's label set (fork/sync/labels.py): a dry run lists each open issue's labels before and after;
    --apply writes the set, relabels, and deletes the old labels only once every open issue is moved. It never
    closes an issue."""
    folder = os.path.join(os.path.abspath(a.repo), "fork", "patches")
    have = {int(f[:-5]) for f in (os.listdir(folder) if os.path.isdir(folder) else [])
            if f.endswith(".json") and f[:-5].isdigit()}
    return labels.run(gate.gh, have, apply=a.apply)


def labels_args(c):
    c.add_argument("--repo", default=".", help="the repo whose fork/patches/ says which issues are patches")
    c.add_argument("--apply", action="store_true", help="write it (default: a dry run that writes nothing)")


def issues_args(c):
    c.add_argument("sha", help="the installed commit's full SHA")
    run_args(c)
    c.add_argument("--since", help="the install before it (default: the state's install history)")
    c.add_argument("--dry-run", action="store_true", help="read and plan only: write nothing, show the comments")
    c.add_argument("--tag", help="a dry run's install tag, when the commit isn't the baseline")


def part_of(a, p):
    """The fork check's rule for a pull request: each patch file its branch changes is named by `Part of #n` in its
    body (and the umbrella its line names). Refused with the exact lines to add."""
    try:
        with open(a.body_file, encoding="utf-8") as f:
            body = f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise Refused(f"the pull request's body can't be read ({type(e).__name__})", outcome="stop")
    missing = issues.part_of_missing(os.path.abspath(a.repo), a.base, a.head, body, a.branch)
    if missing is None:
        raise Refused("the branch's changes can't be listed", outcome="stop")
    if missing:
        raise Refused("this pull request changes a patch file but its description doesn't name the issue: add "
                      + " and ".join(f'the line "{m}"' for m in missing), outcome="refused", add=missing)
    return {"add": []}


def part_of_args(c):
    c.add_argument("--base", required=True, help="the pull request's base commit")
    c.add_argument("--head", required=True, help="its head (or merge) commit")
    c.add_argument("--body-file", required=True, help="its description, as a file")
    c.add_argument("--branch", help="its head branch (a sync/* branch is exempt)")
    c.add_argument("--repo", default=".", help="the repo (default: here)")


def finish_args(c):
    run_args(c)
    c.add_argument("--says", help="what's new, for an install's --told (the rest of the words are the state's)")
    c.add_argument("--wait-ci", action="store_true", help="hand this run to `ci`, which waits for main's CI on its "
                                                          "installs (#230: by default no run waits; a later one reads it)")


COMMANDS = [
    ("preflight", "checks the repo, takes the run's lease, reads state, says where to resume", preflight_only_args,
     preflight),
    ("select", "the newest stable release and the run's path", run_args, select),
    ("settle", "Install merged: main's tip pinned, and the run's path", run_args, settle),
    ("review-inputs", "the reviewer's three diffs for the sync branch, as files", run_args, review_inputs),
    ("merge", "the one merge route for a sync PR", merge_args, merge),
    ("baseline", "reads what is installed and proves it matches the install folder", baseline_args, baseline),
    ("install", "moves the install folder and asks for the update, then reads its outcome", sha_args, install_step),
    ("health", "the health check on the installed candidate", sha_args, health),
    ("rollback", "back to the baseline, verified", run_args, rollback),
    ("public-check", "refuses text with paths, hosts, emails or raw output", public_check_args, public_check),
    ("finish", "the exact completion command for the run's outcome", finish_args, finish),
    ("ci", "CI's verdict on this run's installs of our merges, then the completion command", run_args, ci),
    ("issues", "after a healthy install: live comments, device checks, and closes for linked Triage fixes", issues_args,
     issues_step),
    ("labels", "our repo's label set and its one migration (dry run unless --apply)", labels_args, labels_step),
    ("part-of", "a pull request that changes a patch file names its issue (Part of #n)", part_of_args, part_of),
    ("hold", "writes the held record, or the 24-hour question's asking or answer", hold_args, hold),
    ("held", "reads the held records", None, held),
    ("patch-list", "the patches a tree or a commit carries", patch_list_args, patch_list),
    ("patch-tests", "runs each patch's tests (fork/patches/<issue>.json)", patch_tests_args, patch_tests),
    ("clear-broken", "the person's only: clears a broken phase", None, clear_broken),
]


def main(argv=None):
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--root", help=argparse.SUPPRESS)
    ap = argparse.ArgumentParser(prog="fork/bin/sync", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="step", required=True, metavar="<step>")
    run = {}
    for name, words, setup, fn in COMMANDS:
        c = sub.add_parser(name, help=words, parents=[common])
        if setup:
            setup(c)
        run[name] = fn
    a = ap.parse_args(argv)
    p = state.Paths(a.root)
    try:
        fields = run[a.step](a, p)
        ok = True
    except Refused as e:
        fields, ok = {"why": e.why, **e.fields}, False
    print(json.dumps({"ok": ok, "step": a.step, **fields}))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
